; TVSTEREO.SCR - DEBUG script for the Terminal Velocity 1.2 stereo fix.
; Used by TVSTEREO.BAT as:  DEBUG < TVSTEREO.SCR > NUL
;
; DEBUG has no comment syntax: it answers each ";" line with "^ Error"
; and ignores it. That is harmless. Comments are kept outside the "a"
; (assemble) blocks so no code line is ever affected.
;
; This script assembles a tiny program, TVFIX.COM, then quits.
;   TVFIX     checks GAME.EXE only, changes nothing
;   TVFIX P   checks GAME.EXE; patches it ONLY if its CRC32 is the
;             original's, then re-checks the CRC32 of the result
; Exit codes: 0 = OK (original found, or patched and verified)
;             1 = cannot open GAME.EXE   2 = wrong CRC32 (unknown file)
;             3 = already patched        4 = read/write/verify error
; CRC32 of the whole GAME.EXE (624,695 bytes):
;   original E995B3E9, patched 1B58E5F5.
;
; All numbers are hex. Each block starts at a fixed address ("a xxx")
; so jump targets never depend on instruction sizes. All conditional
; jumps stay within 127 bytes, as the 8086 requires.
;
; Fill the program area with NOPs (90) so blocks can run into the next.
f 100 26f 90
;
; === 100 MAIN ===
; Open GAME.EXE (name at 260) read/write; if that fails exit 1.
; Keep the handle in BX. CRC32 the whole file into DI:SI (high:low);
; read error: exit 4. Not E995B3E9: go to NOTORIG. Else go to ORIG.
a 100
mov dx,260
mov ax,3d02
int 21
jb 140
mov bx,ax
call 1c0
jb 138
cmp di,e995
jnz 158
cmp si,b3e9
jnz 158
jmp 168

;
; === 120..140 EXITS === put the exit code in DL, then go to CLOSE.
a 120
mov dl,0
jmp 148

a 128
mov dl,2
jmp 148

a 130
mov dl,3
jmp 148

a 138
mov dl,4
jmp 148

; 140: open failed, so there is no handle to close. Exit 1.
a 140
mov ax,4c01
int 21

; === 148 CLOSE === close the file (BX), exit with code DL.
a 148
mov ah,3e
int 21
mov al,dl
mov ah,4c
int 21

; === 158 NOTORIG === CRC32 is not the original's.
; 1B58E5F5 means already patched: exit 3. Anything else: exit 2.
a 158
cmp di,1b58
jnz 128
cmp si,e5f5
jnz 128
jmp 130

; === 168 ORIG === the file is the original. Patch only for "TVFIX P":
; PSP:80 is the command tail length, PSP:82 its first character after
; the space. Upper-case it (AND DF) and compare with "P" (50); if not,
; exit 0 having changed nothing. Else SI = patch table, BP = 4 entries.
a 168
cmp byte ptr [80],2
jb 120
mov al,[82]
and al,df
cmp al,50
jnz 120
mov si,230
mov bp,4

; === 180 WRITE === for each table entry: seek (CX:DX = offset),
; write the new bytes (count at [SI+4], bytes at SI+6), check that all
; were written, next entry (9 bytes on). Any error: exit 4.
; Then CRC32 the file again: must be 1B58E5F5 or exit 4. Else exit 0.
a 180
mov ax,4200
mov cx,[si]
mov dx,[si+2]
int 21
jb 138
mov ah,40
mov cx,[si+4]
lea dx,[si+6]
int 21
jb 138
cmp ax,cx
jnz 138
add si,9
dec bp
jnz 180
call 1c0
jb 138
cmp di,1b58
jnz 138
cmp si,e5f5
jnz 138
jmp 120

; === 1C0 CRC32 subroutine === standard CRC32 (polynomial EDB88320)
; of the whole file, in 8086 code. Rewind to the start; CRC = FFFFFFFF.
; Returns the CRC in DI:SI, or carry set on a read error.
a 1c0
mov ax,4200
xor cx,cx
xor dx,dx
int 21
jb 220
mov si,ffff
mov di,ffff

; 1D8: read up to 8000 bytes into the buffer at 1000. 0 bytes = end of
; file. CX = bytes to do, BX = buffer pointer (the handle is saved).
a 1d8
mov ah,3f
mov cx,8000
mov dx,1000
int 21
jb 220
or ax,ax
jz 218
mov cx,ax
push bx
mov bx,1000

; 1F0: XOR the next byte into the low byte of the CRC. DL = 8 bits.
a 1f0
mov al,[bx]
xor ah,ah
xor si,ax
mov dl,8

; 1F8: shift the CRC right 1 bit; if a 1 fell out, XOR in EDB88320.
a 1f8
shr di,1
rcr si,1
jnb 208
xor di,edb8
xor si,8320

; 208: next bit, next byte, next buffer.
a 208
dec dl
jnz 1f8
inc bx
loop 1f0
pop bx
jmp 1d8

; 218: end of file. Final CRC = NOT CRC. Return with carry clear.
a 218
not si
not di
clc
ret

; 220: read error. Return with carry set.
a 220
ret

; === 230 PATCH TABLE === each entry: offset high word, low word,
; byte count, new bytes (3, unused ones 00). File offsets:
; 054864: 88 5D FF -> 88 5D FE  stereo mixer, store BL at [EBP-2]
; 05486B: 88 4D FE -> 88 4D FF  stereo mixer, store CL at [EBP-1]
; 054E8D: 88 18    -> 88 08     surround mixer, store CL at [EAX]
; 054E92: 88 48 01 -> 88 58 01  surround mixer, store BL at [EAX+1]
e 230 05 00 64 48 03 00 88 5d fe
e 239 05 00 6b 48 03 00 88 4d ff
e 242 05 00 8d 4e 02 00 88 08 00
e 24b 05 00 92 4e 03 00 88 58 01
;
; === 260 FILE NAME === zero terminated.
e 260 "GAME.EXE" 0
;
; Save 170 bytes (100..26F) as TVFIX.COM, then quit DEBUG.
n tvfix.com
rbx
0
rcx
170
w
q
